/*
 * Corne Mini (3x5+3, ZMK) — transition map ported from the 6-column Vial Corne.
 * Target: mbastar/zmk-config-cornemini2 → config/corne.keymap
 *
 * Ported as-is from the Vial board: number/nav layer on the left thumb, symbol/F-key
 * layer on the right thumb, all six bracket + utility combos, mod order GUI/ALT/CTRL/SHFT.
 * New: home-row mods (the old thumb-row CTL/GUI/SHFT keys do not exist here).
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define DEF   0
#define NAV   1
#define SYM   2
#define ADJ   3
#define MOUSE 4

/* Layer-taps now sit on BSPC and DEL, which you sometimes want to hold down to
   repeat. quick-tap-ms restores that: tap the key, then press-and-hold again
   within 200 ms and it repeats the tap instead of entering the layer. */
&lt { quick-tap-ms = <200>; };

/* 42-key matrix; outer columns (0, 11, 12, 23, 24, 35) are unpopulated on the Mini.
   Left:  0-5   12-17  24-29  thumbs 36 37 38
   Right: 6-11  18-23  30-35  thumbs 39 40 41 */

#define LEFT_KEYS   0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29
#define RIGHT_KEYS  6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35
#define LEFT_THUMB  36 37 38
#define RIGHT_THUMB 39 40 41

/ {
    behaviors {
        /* Home-row mods. Cross-hand only: a left-hand mod fires only if a RIGHT-hand
           key follows, which is what stops "df" turning into ctrl+d. */

        /* Three tiers, tuned by how often the TAP character is typed --
           not by which finger it is. Misfire risk scales with tap frequency;
           the cost of a hard hold scales with how often you need the mod. */

        /* Index + middle (D F J K -> CTRL, SHIFT). Pressed mid-roll, so the
           hold has to be easy to get: shorter term, and prior-idle dropped
           from 150 to 80 because that guard was eating Shift when it followed
           a letter fast -- the "f/ instead of ?" failure. */
        hmli: home_row_mod_left_index {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <80>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <RIGHT_KEYS RIGHT_THUMB>;
            hold-trigger-on-release;
        };

        hmri: home_row_mod_right_index {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <80>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <LEFT_KEYS LEFT_THUMB>;
            hold-trigger-on-release;
        };

        /* Ring + pinky (S L ' -> ALT, ALT, GUI). Unchanged from the tuning that
           has been running two weeks. ALT stays fast because option-arrow and
           option-backspace are mid-flow editing gestures; ' stays fast because
           it is the only source of Cmd for every left-hand letter. */
        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <RIGHT_KEYS RIGHT_THUMB>;
            hold-trigger-on-release;
        };

        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <LEFT_KEYS LEFT_THUMB>;
            hold-trigger-on-release;
        };

        /* Left pinky only (A -> GUI). tap-preferred resolves as HOLD only when
           the 280 ms term actually expires, no matter what else is pressed --
           so "an", "and", "man", "a " can no longer become Cmd-N or Cmd-Space.
           'a' is ~8% of English letters, which is why this one key needs the
           guard; ' is under 0.3%, which is why the right pinky does not.
           Cost: Cmd-N/K/P now need a deliberate 280 ms hold on A first. */
        hmlp: home_row_mod_left_pinky {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <RIGHT_KEYS RIGHT_THUMB>;
            hold-trigger-on-release;
        };

        caps: caps {
            compatible = "zmk,behavior-caps-word";
            #binding-cells = <0>;
            continue-list = <MINUS UNDERSCORE BACKSPACE>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        tri_layer {
            if-layers = <NAV SYM>;
            then-layer = <ADJ>;
        };
    };

    combos {
        compatible = "zmk,combos";

        /* --- ported 1:1 from the Vial Corne (all positions survive the lost column) --- */

        screenshot {
            bindings = <&kp LG(LS(N4))>;
            key-positions = <1 25>;
            layers = <DEF>;
        }; /* Q + Z */
        dictation {
            bindings = <&kp F13>;
            key-positions = <32 33>;
            layers = <DEF>;
        }; /* , + . -> F13 (Raycast dictation). Was RGUI: VoiceInk listens to
              bare right-GUI, so every cross-hand Cmd from the `;` home-row mod
              flashed the dictation window. F13 exists on no layer and no board. */
        lpar {
            bindings = <&kp LPAR>;
            key-positions = <4 5>;
            layers = <DEF>;
        }; /* R + T */
        rpar {
            bindings = <&kp RPAR>;
            key-positions = <6 7>;
            layers = <DEF>;
        }; /* Y + U */
        lbkt {
            bindings = <&kp LBKT>;
            key-positions = <16 17>;
            layers = <DEF>;
        }; /* F + G */
        rbkt {
            bindings = <&kp RBKT>;
            key-positions = <18 19>;
            layers = <DEF>;
        }; /* H + J */
        lbrc {
            bindings = <&kp LBRC>;
            key-positions = <28 29>;
            layers = <DEF>;
        }; /* V + B */
        rbrc {
            bindings = <&kp RBRC>;
            key-positions = <30 31>;
            layers = <DEF>;
        }; /* N + M */
        /* --- new: replaces keys the Mini has no room for --- */

        capsword {
            bindings = <&caps>;
            key-positions = <16 19>;
        };  /* F + J  → caps word (was SHFT)   */
        plus {
            bindings = <&kp PLUS>;
            key-positions = <16 17>;
            layers = <SYM>;
        };  /* SYM: - and = pressed together -> +. `+` was unreachable by ANY
               gesture: `=` lives only on SYM, shift lives only on DEF's
               home-row mods and NAV, and holding SYM turns the F/shift key
               into `-`. Scoped to SYM, so F+G on the base layer is still `[`.
               &kp PLUS emits shift+equal itself, so no shift source needed.
               Timeout left at the 50 ms default to match the F+G `[` combo,
               which is the same physical gesture and already trained. The one
               false-fire risk is typing `-=` fast (a real operator): if that
               bites, add `timeout-ms = <30>;` here rather than
               require-prior-idle-ms, which would also suppress a deliberate
               `+` mid-expression -- the same trap that killed the `'` combo. */
        del {
            bindings = <&kp DEL>;
            key-positions = <27 28>;
        };  /* C + V  → DEL. Was S+X: same finger, two rows, ring splayed --
               confirmed uncomfortable in use. "cv" is in no English word, and the
               V overlap with V+B is resolved by which keys are actually down.
               DEL also stays on NAV and SYM at the right pinky bottom.  */
    };

    keymap {
        compatible = "zmk,keymap";

        DEF {
            display-name = "Base";

            // |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U  |  I  |  O  |  P  |
            // |  A  |  S  |  D  |  F  |  G  |   |  H  |  J  |  K  |  L  |  '  |   home-row mods
            //                                                              tap = ' (shift = "); hold = RGUI
            // |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M  |  ,  |  .  |  /  |
            //         | TAB | ENT | ESC/NAV |   | BSPC/SYM | SPC | DEL/SYM |
            //   SYM moved from the outer right thumb to the inner one, mirroring NAV
            //   on the inner left. The outer key keeps a SYM hold as a fallback and
            //   picks up DEL on the tap.

            bindings = <
&trans  &kp Q         &kp W        &kp E          &kp R          &kp T          &kp Y     &kp U          &kp I          &kp O        &kp P           &trans
&trans  &hmlp LGUI A  &hml LALT S  &hmli LCTRL D  &hmli LSHFT F  &kp G          &kp H     &hmri RSHFT J  &hmri RCTRL K  &hmr RALT L  &hmr RGUI SQT   &trans
&trans  &kp Z         &kp X        &kp C          &kp V          &kp B          &kp N     &kp M          &kp COMMA      &kp DOT      &kp FSLH        &trans
                                   &kp TAB        &kp RET        &lt NAV ESC    &lt SYM BSPC  &kp SPACE      &lt SYM DEL
            >;

            /* FALLBACK ONLY -- if home-row mods genuinely fight you, swap this row in:
&trans  &kp A  &kp S  &kp D  &kp F  &kp G   &kp H  &kp J  &kp K  &kp L  &kp SQT   &trans
               ...but Shift then has nowhere to live (no pinky column, no thumb row on
               this board), so you must ALSO move Shift onto a thumb in the same edit:
                       &mt LSHFT TAB   &kp RET   &lt NAV ESC
               Capitals via a layer hold is not a workable typing experience. */
        };

        NAV {
            display-name = "Nav/Num";

            // |  1  |  2  |  3  |  4  |  5  |   |  6  |  7   |  8   |  9  |  0  |
            // | GUI | ALT | CTL | SFT |     |   |  <- |  v   |  ^   |  -> | END |
            // |     |     |     |     |     |   | PGUP| PGDN | HOME |     | DEL |

            bindings = <
&trans  &kp N1    &kp N2    &kp N3     &kp N4     &kp N5    &kp N6     &kp N7     &kp N8    &kp N9     &kp N0   &trans
&trans  &kp LGUI  &kp LALT  &kp LCTRL  &kp LSHFT  &trans    &kp LEFT   &kp DOWN   &kp UP    &kp RIGHT  &kp END  &trans
&trans  &trans    &trans    &trans     &trans     &trans    &kp PG_UP  &kp PG_DN  &kp HOME  &trans     &kp DEL  &trans
                            &trans     &trans     &trans    &trans     &trans     &trans
            >;
        };

        SYM {
            display-name = "Sym/Fn";

            // |  !  |  @  |  #  |  $  |  %  |   | F7 | F8 | F9 | F10 |  :  |
            // |  ^  |  &  |  *  |  -  |  =  |   | F4 | F5 | F6 | F11 |  ;  |
            // |  _  |  `  |  ~  |  \  | "|" |   | F1 | F2 | F3 | F12 | DEL |
            //   combo: - + =  ->  +

            bindings = <
&trans  &kp EXCL   &kp AT     &kp HASH   &kp DLLR   &kp PRCNT    &kp F7  &kp F8  &kp F9  &kp F10  &kp COLON  &trans
&trans  &kp CARET  &kp AMPS   &kp ASTRK  &kp MINUS  &kp EQUAL    &kp F4  &kp F5  &kp F6  &kp F11  &kp SEMI   &trans
&trans  &kp UNDER  &kp GRAVE  &kp TILDE  &kp BSLH   &kp PIPE     &kp F1  &kp F2  &kp F3  &kp F12  &kp DEL    &trans
                              &trans     &trans     &trans       &trans  &trans  &trans
            >;
        };

        ADJ {
            display-name = "System";

            // reached by holding NAV + SYM together (conditional layer)
            // |     |     |     |     |     |   |     |     |     |     |     |
            // | BT0 | BT1 | BT2 |BTCLR| STUDIO |  |     |     |     |     |MOUSE|
            // | BOOT|RESET|     |     |BTCLRA| |     |     |     |RESET| BOOT |
            //
            // &bootloader / &sys_reset are SOURCE-SPECIFIC on a split: each one only
            // affects the half it is physically pressed on. Both halves need their own.
            // (Combos are the exception -- a combo always fires on the central/left half.)

            bindings = <
&trans  &trans        &trans        &trans        &trans      &trans            &trans  &trans  &trans  &trans      &trans       &trans
&trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_CLR  &studio_unlock    &trans  &trans  &trans  &trans      &tog MOUSE   &trans
&trans  &bootloader   &sys_reset    &trans        &trans      &bt BT_CLR_ALL    &trans  &trans  &trans  &sys_reset  &bootloader  &trans
                                    &trans        &trans      &trans            &trans  &trans  &trans
            >;
        };

        MOUSE {
            display-name = "Mouse";
            bindings = <
&trans  &trans  &trans          &mmv MOVE_UP    &trans           &msc SCRL_UP      &trans  &trans     &trans     &trans  &trans      &trans
&trans  &trans  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &msc SCRL_DOWN    &trans  &mkp LCLK  &mkp RCLK  &trans  &trans      &trans
&trans  &trans  &trans          &trans          &trans           &trans            &trans  &trans     &trans     &trans  &tog MOUSE  &trans
                                &trans          &trans           &trans            &trans  &trans     &trans
            >;
        };

        /* Empty slots so ZMK Studio can hand out extra layers with no rebuild.
           Delete these two lines if the v0.3 build rejects them. */

        extra1 { status = "reserved"; };

        extra2 { status = "reserved"; };
    };
};
